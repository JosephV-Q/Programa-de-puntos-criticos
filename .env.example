# Neon PostgreSQL. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# JWT settings
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
JWT_EXPIRE_MINUTES=480

# Optional administrator bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Administrador del sistema

# Frontend API base URL
VITE_API_URL=http://localhost:8000/api

# PostgreSQL integration test database, separate from production
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/TEST_DATABASE?sslmode=require
